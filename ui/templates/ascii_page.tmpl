{{define "title"}}ascii · OMNI{{end}}

{{define "body"}}
    <header class="site-header">
        <a href="/" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/>
            </svg>
            OMNI
        </a>
        <p class="plugin-label" style="margin: 0;">
            <a href="/plugins" style="color: inherit; text-decoration: none;">Plugins</a> <span class="breadcrumb-sep">/</span>
            <svg class="plugin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2"/>
                <path d="M7 8h2l1 4 1-4h2M15 8v8M7 16h3"/>
            </svg>
            <span class="title-text">ASCII</span>
        </p>
        <a href="/settings" class="back-link">settings</a>
    </header>
    <main class="plugins">
        <div class="plugin">

            <div class="ascii-toolbar">
                <form method="GET" action="/ascii" class="ascii-filter-form">
                    <input name="q" class="ascii-search app-input" placeholder="search animations…" aria-label="Search animations" value="{{.Query}}" autocomplete="off">
                    <select name="size" class="ascii-size-filter" aria-label="Filter by size">
                        <option value="">all sizes</option>
                        {{range .Sizes}}<option value="{{.}}"{{if eq . $.SizeFilter}} selected{{end}}>{{.}}</option>{{end}}
                    </select>
                    <input type="hidden" name="page" value="1">
                </form>
                <div class="ascii-import-export">
                    <button class="ascii-import-btn" id="ascii-import-btn" type="button">Import ▾</button>
                    <div class="ascii-import-dropdown" id="ascii-import-dropdown" hidden>
                        <button class="ascii-import-option" data-type="local" type="button">Local folder</button>
                        <div class="ascii-import-dropdown-sep" aria-hidden="true"></div>
                        <button class="ascii-import-option" type="button" disabled>Remote (coming soon)</button>
                    </div>
                    <input type="file" id="ascii-import-file-input" webkitdirectory style="display:none">
                </div>
                <button class="ascii-export-btn" id="ascii-export-btn" type="button">Export</button>
                <button class="ascii-new-btn">+ New animation</button>
            </div>

            <div class="ascii-import-result" id="ascii-import-result" hidden>
                <span class="ascii-import-result-text" id="ascii-import-result-text"></span>
                <button class="ascii-import-result-close" id="ascii-import-result-close" type="button">&times;</button>
            </div>

            {{if .Animations}}
            <div class="widget-grid ascii-gallery-grid">
                {{range .Animations}}
                {{$animName := .Name}}
                {{$isRemote := .Source}}
                {{range .Variants}}
                <div class="widget ascii-gallery-item"
                     style="grid-column: span {{sizeW .Size}}; grid-row: span {{sizeH .Size}}"
                     data-name="{{$animName}}" data-size="{{.Size}}">
                    <div id="asc-{{$animName}}-{{.Size}}" class="ascii-scope">
                        {{paletteCSS $animName .Size .Palette}}
                        <div class="widget-fill ascii-canvas"
                             data-ascii-cols="{{.Cols}}"
                             data-ascii-rows="{{.Rows}}"
                             data-ascii-fps="{{.FPS}}"
                             data-ascii-frames-url="/api/ascii/frames/{{$animName}}?size={{.Size}}">
                            <div class="ascii-pause-indicator" hidden>
                                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                                    <rect x="6" y="4" width="4" height="16"/>
                                    <rect x="14" y="4" width="4" height="16"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                    <div class="ascii-gallery-overlay">
                        <div class="ascii-gallery-meta">
                            <span class="ascii-gallery-name">{{$animName}}</span>
                            <span class="ascii-gallery-size">{{.Size}} · {{.Cols}}×{{.Rows}}</span>
                            {{if $isRemote}}<span class="ascii-card-badge">remote</span>{{end}}
                        </div>
                        {{if not $isRemote}}
                        <div class="ascii-gallery-actions">
                            <button class="ascii-edit-variant-btn ascii-gallery-btn" data-name="{{$animName}}" data-size="{{.Size}}">edit</button>
                            <button class="ascii-delete-variant-btn ascii-gallery-btn" data-name="{{$animName}}" data-size="{{.Size}}">delete</button>
                        </div>
                        {{end}}
                    </div>
                </div>
                {{end}}
                {{end}}
            </div>

            {{if gt .TotalPages 1}}
            <div class="table-pagination">
                {{if .HasPrev}}
                <a class="pagination-btn" href="/ascii?page={{.PrevPage}}&q={{.Query}}&size={{.SizeFilter}}">← prev</a>
                {{else}}
                <span class="pagination-btn disabled">← prev</span>
                {{end}}
                <div class="pagination-pages">
                    {{range .Pages}}
                    {{if .Ellipsis}}<span class="pagination-ellipsis">…</span>
                    {{else}}<a class="pagination-page-btn{{if .Active}} active{{end}}" href="/ascii?page={{.N}}&q={{$.Query}}&size={{$.SizeFilter}}">{{.N}}</a>
                    {{end}}
                    {{end}}
                </div>
                {{if .HasNext}}
                <a class="pagination-btn" href="/ascii?page={{.NextPage}}&q={{.Query}}&size={{.SizeFilter}}">next →</a>
                {{else}}
                <span class="pagination-btn disabled">next →</span>
                {{end}}
                <span class="pagination-info">{{.Start}}–{{.End}} of {{.Total}}</span>
            </div>
            {{end}}

            {{else}}
            <div class="ascii-empty">
                <p>No animations yet.</p>
                <button class="ascii-new-btn">+ New animation</button>
            </div>
            {{end}}

        </div>
    </main>

    <!-- ASCII Export Modal -->
    <div class="ascii-export-overlay" id="ascii-export-overlay">
        <div class="ascii-export-modal">
            <div class="ascii-modal-header">
                <span class="ascii-modal-title">Export animations</span>
                <button class="ascii-modal-close" id="ascii-export-close" aria-label="Close">&times;</button>
            </div>
            <div class="ascii-export-body">
                <label class="ascii-export-select-all">
                    <input type="checkbox" class="app-checkbox" id="ascii-export-select-all"> Select all
                </label>
                <div class="ascii-export-list" id="ascii-export-list">
                    <!-- populated by JS from /api/ascii/animations -->
                </div>
                <div class="ascii-export-pack-meta" id="ascii-export-pack-meta" style="display:none">
                    <label>Author<input type="text" class="app-input" id="ascii-export-pack-author" placeholder="username"></label>
                    <label>Pack name<input type="text" class="app-input" id="ascii-export-pack-name" placeholder="my-pack"></label>
                    <label>Description<input type="text" class="app-input" id="ascii-export-pack-description" placeholder="A short description"></label>
                    <label>Version<input type="text" class="app-input" id="ascii-export-pack-version" value="1.0.0"></label>
                    <label>License<input type="text" class="app-input" id="ascii-export-pack-license" placeholder="MIT"></label>
                </div>
            </div>
            <div class="ascii-modal-footer">
                <span class="ascii-modal-errors" id="ascii-export-errors"></span>
                <button class="ascii-modal-cancel" id="ascii-export-cancel" type="button">Cancel</button>
                <button class="ascii-modal-save" id="ascii-export-download" type="button">Download zip</button>
            </div>
        </div>
    </div>

    <!-- ASCII CRUD Modal -->
    <div class="ascii-modal-overlay" id="ascii-modal-overlay">
        <div class="ascii-modal">
            <div class="ascii-modal-header">
                <span class="ascii-modal-title" id="ascii-modal-title">New Animation</span>
                <button class="ascii-modal-close" id="ascii-modal-close" aria-label="Close">&times;</button>
            </div>
            <div class="ascii-modal-body">
                <!-- LEFT SIDEBAR -->
                <div class="ascii-modal-sidebar">
                    <div class="ascii-modal-form">
                        <label>
                            Name
                            <input type="text" class="app-input" id="ascii-form-name" placeholder="my-animation" autocomplete="off">
                        </label>
                        <label data-tip="The widget's footprint on the dashboard grid — columns × rows (e.g. 2x1 spans 2 columns and 1 row).">
                            Size
                            <div class="ascii-size-row">
                                <input type="text" class="app-input" id="ascii-form-size" placeholder="2x1" autocomplete="off">
                                <button class="ascii-fit-btn" id="ascii-fit-btn" type="button" title="Suggest cols/rows that fill this widget size">Fit</button>
                            </div>
                            <div class="ascii-fit-suggestions" id="ascii-fit-suggestions" hidden></div>
                        </label>
                        <div class="ascii-form-row ascii-form-row--compact">
                            <label>
                                Cols
                                <input type="number" class="app-input" id="ascii-form-cols" min="1" value="80">
                            </label>
                            <label>
                                Rows
                                <input type="number" class="app-input" id="ascii-form-rows" min="1" value="24">
                            </label>
                            <label>
                                FPS
                                <input type="number" class="app-input" id="ascii-form-fps" min="1" max="60" value="12">
                            </label>
                        </div>

                        <div class="ascii-palette-editor">
                            <div class="ascii-palette-header">
                                <span class="ascii-palette-label">Palette</span>
                                <button class="ascii-palette-add" id="ascii-palette-add" type="button">+ Add color</button>
                            </div>
                            <div id="ascii-palette-rows" class="ascii-palette-rows-grid"></div>
                        </div>

                    </div>
                </div>

                <!-- Drag resize handle -->
                <div class="ascii-modal-resize-handle" id="ascii-modal-resize-handle"></div>

                <!-- RIGHT EDITOR AREA -->
                <div class="ascii-modal-editor">
                    <div class="ascii-editor-content">
                    <!-- Canvas wrapper: sizing context for absolutely-positioned tool strip + flyout -->
                    <div class="ascii-canvas-wrapper">
                    <!-- Preview pane with grid overlay -->
                    <div class="ascii-preview-pane" id="ascii-preview-pane">
                        <p class="ascii-preview-empty">Add a blank frame to begin</p>
                        <div class="ascii-grid-overlay" id="ascii-grid-overlay" style="display:none"></div>
                    </div>
                    <!-- Tool strip: thin column on left edge, visible when frames are loaded -->
                    <div class="ascii-tool-strip" id="ascii-tools" style="display:none">
                        <button class="ascii-tool-btn" id="ascii-tool-cursor" type="button" title="Select">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14" aria-hidden="true"><path d="M5.5 3.5l13 8.5-6.5 1-3.5 6.5z"/></svg>
                        </button>
                        <button class="ascii-tool-btn" id="ascii-tool-pencil" type="button" title="Paint">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="14" height="14" aria-hidden="true"><path d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="ascii-tool-strip-sep" aria-hidden="true"></div>
                        <button class="ascii-tool-btn" id="ascii-tool-onion" type="button" title="Onion skin">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="14" height="14" aria-hidden="true"><path d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" stroke-linecap="round" stroke-linejoin="round"/><path d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <div class="ascii-tool-strip-sep" aria-hidden="true"></div>
                        <button class="ascii-tool-btn" id="ascii-tool-replace" type="button" title="Remap character (⌘H)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" width="14" height="14" aria-hidden="true"><path d="M4 8h11M12 5l3 3-3 3" stroke-linecap="round" stroke-linejoin="round"/><path d="M20 16H9M12 19l-3-3 3-3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </div>
                    <!-- Tool flyout: char + palette swatches, shown when pencil is active -->
                    <div class="ascii-tool-flyout" id="ascii-tool-flyout" style="display:none">
                        <span class="ascii-flyout-char" id="ascii-flyout-char" title="Click to edit character"> </span>
                        <input type="text" id="ascii-tool-char" class="ascii-tool-char" maxlength="2" value=" " aria-label="Paint character">
                        <div class="ascii-swatch-row" id="ascii-swatch-row"></div>
                        <select id="ascii-tool-class" class="ascii-tool-class" aria-hidden="true" style="display:none">
                            <option value="">(none)</option>
                        </select>
                    </div>
                    </div><!-- /.ascii-canvas-wrapper -->

                    <!-- Remap character bar – shown when remap tool is toggled -->
                    <div class="ascii-replace-bar" id="ascii-replace-bar" style="display:none" role="search" aria-label="Remap character">
                        <span class="ascii-replace-label" aria-hidden="true">remap</span>
                        <div class="ascii-replace-char-wrap">
                            <span class="ascii-replace-char-preview empty" id="ascii-replace-from-preview" title="Click to edit" aria-hidden="true">·</span>
                            <input type="text" id="ascii-replace-from" class="ascii-replace-char-input" maxlength="2" value="" aria-label="Find character" autocomplete="off" spellcheck="false">
                        </div>
                        <span class="ascii-replace-arrow" aria-hidden="true">→</span>
                        <span class="ascii-replace-label" aria-hidden="true">→</span>
                        <div class="ascii-replace-char-wrap">
                            <span class="ascii-replace-char-preview empty" id="ascii-replace-to-preview" title="Click to edit (leave empty to erase)" aria-hidden="true">·</span>
                            <input type="text" id="ascii-replace-to" class="ascii-replace-char-input" maxlength="2" value="" aria-label="Replace with character (empty = space)" autocomplete="off" spellcheck="false">
                        </div>
                        <div class="ascii-replace-scope" role="group" aria-label="Replacement scope">
                            <button class="ascii-replace-scope-btn active" data-scope="all" type="button">all frames</button>
                            <button class="ascii-replace-scope-btn" data-scope="current" type="button">this frame</button>
                        </div>
                        <button class="ascii-replace-apply" id="ascii-replace-apply" type="button" disabled>Remap</button>
                        <span class="ascii-replace-hint" id="ascii-replace-hint" aria-live="polite"></span>
                    </div>

                    <!-- Timeline transport -->
                    <div class="ascii-timeline" id="ascii-timeline" style="display:none">
                        <div class="ascii-timeline-controls">
                            <button class="ascii-timeline-btn" id="ascii-tl-first" type="button" title="First frame">&#x23EE;</button>
                            <button class="ascii-timeline-btn" id="ascii-tl-prev" type="button" title="Previous frame">&#x23F4;</button>
                            <button class="ascii-timeline-btn ascii-tl-play" id="ascii-tl-play" type="button" title="Play/Pause">&#x25B6;</button>
                            <button class="ascii-timeline-btn" id="ascii-tl-next" type="button" title="Next frame">&#x23F5;</button>
                            <button class="ascii-timeline-btn" id="ascii-tl-last" type="button" title="Last frame">&#x23ED;</button>
                            <span class="ascii-frame-counter" id="ascii-frame-counter">0 / 0</span>
                            <label class="ascii-speed-control">
                                <select class="ascii-speed-select" id="ascii-speed-select">
                                    <option value="0.25">0.25x</option>
                                    <option value="0.5">0.5x</option>
                                    <option value="1" selected>1x</option>
                                    <option value="2">2x</option>
                                </select>
                            </label>
                        </div>
                        <input type="range" class="ascii-frame-slider" id="ascii-frame-slider" min="0" max="0" value="0">
                        <!-- Frame operations -->
                        <div class="ascii-frame-ops">
                            <button class="ascii-timeline-btn" id="ascii-op-dup" type="button" title="Duplicate frame">Dup</button>
                            <button class="ascii-timeline-btn" id="ascii-op-blank" type="button" title="Insert blank frame">+Blank</button>
                            <button class="ascii-timeline-btn" id="ascii-op-del" type="button" title="Delete frame">Del</button>
                            <button class="ascii-timeline-btn" id="ascii-op-left" type="button" title="Move frame left">&#x2190;</button>
                            <button class="ascii-timeline-btn" id="ascii-op-right" type="button" title="Move frame right">&#x2192;</button>
                        </div>
                    </div>
                    </div><!-- /.ascii-editor-content -->
                </div>
            </div>
<div class="ascii-modal-footer">
                <span class="ascii-modal-errors" id="ascii-modal-errors"></span>
                <button class="ascii-modal-cancel" id="ascii-modal-cancel" type="button">Cancel</button>
                <button class="ascii-modal-save" id="ascii-modal-save" type="button">Save</button>
            </div>
        </div>
    </div>
{{end}}
